{
  "name": "raccoon-obsidian",
  "private": true,
  "description": "Monorepo of Artem Sapegin's Obsidian plugins, built and installed locally",
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "workspaces": [
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "oxlint && oxfmt --check &&  npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "obsidian": "1.14.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-config-raccoon": "10.9.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "nano-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "oxlint --fix",
    "*.{js,mjs,cjs,ts,tsx,json,jsonc,md}": "oxfmt"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true
  }
}
